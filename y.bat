@echo off
setlocal

NET SESSION >nul 2>&1
IF %ERRORLEVEL% NEQ 0 (
    echo Requesting Administrator privileges...
    powershell -Command "Start-Process '%~f0' -Verb RunAs -ArgumentList '%*'"
    exit /b
)

IF "%~1"=="" (
    echo Error: Auth key is required.
    echo Usage: %~nx0 YOUR_AUTH_KEY
    pause
    exit /b 1
)

:: Run the Base64 encoded PowerShell script with the provided key
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand  -authKey "%~1"

pause
